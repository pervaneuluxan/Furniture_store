{
  "name": "furniture_store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --prefix server\" \"vite\"",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run && npm test --prefix server",
    "test:client": "vitest run",
    "server": "npm start --prefix server",
    "postinstall": "npm install --prefix server"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^9.0.0",
    "jsdom": "^26.0.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
